DEFINE TABLE ZP_EXCEPTION CLIENT DEPENDENT AS
{
  KEY EXCEPT_ID   : TYPE CHAR10;
  PLANT           : TYPE WERKS_D;
  MATERIAL        : TYPE MATNR;
  EXCEPT_TYPE     : TYPE ZP_EXCEPT_TYPE;
  SEVERITY        : TYPE CHAR1;
  STATUS          : TYPE ZP_EXCEPT_STATUS;
  DESCRIPTION     : TYPE CHAR200;
  RESPONSIBLE     : TYPE CHAR12;
  CREATED_BY      : TYPE SYUNAME;
  CREATED_AT      : TYPE TIMESTAMPL;
}
// 本地草稿(L1)：透明表；MANDT 随 CLIENT DEPENDENT 隐式生成
// DDL 语法/字段类型待连系统 Activate 时校验；包落点待定(ZXUENHUA 建包失败, 暂用现有包或后补)
